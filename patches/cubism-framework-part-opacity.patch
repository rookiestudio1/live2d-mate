diff --git a/src/Motion/CubismMotion.cpp b/src/Motion/CubismMotion.cpp
index 702f85a..5332cc6 100644
--- a/src/Motion/CubismMotion.cpp
+++ b/src/Motion/CubismMotion.cpp
@@ -554,7 +554,25 @@ void CubismMotion::DoUpdateParameters(CubismModel* model, csmFloat32 userTimeSec
 
     for (; c < _motionData->CurveCount && curves[c].Type == CubismMotionCurveTarget_PartOpacity; ++c)
     {
-        // Find parameter index.
+        // Evaluate curve and apply value.
+        value = EvaluateCurve(_motionData, c, time, isCorrection, duration);
+
+        // Apply to the part opacity when the curve id names a part of this model.
+        // Note: fadeWeight is deliberately not applied here. Part opacity curves are
+        // used as hard switches between alternative art (arms, legs, props); blending
+        // them makes both variants translucent at the same time.
+        const csmInt32 partIndex = model->GetPartIndex(curves[c].Id);
+        if (0 <= partIndex && partIndex < model->GetPartCount())
+        {
+            model->SetPartOpacity(partIndex, value);
+        }
+
+        // Find parameter index. Deliberately no "else": models that switch parts
+        // through CubismPose need this channel as well. PartData::Initialize() looks
+        // the part id up in the *parameter* table and CubismPose::DoFade() reads that
+        // slot back to decide which part of a group is visible, so skipping it would
+        // freeze every pose group on its first part. The pose pass runs after the
+        // motion, so on those models it simply overrides the SetPartOpacity() above.
         parameterIndex = model->GetParameterIndex(curves[c].Id);
 
         // Skip curve evaluation if no value in sink.
@@ -563,9 +581,6 @@ void CubismMotion::DoUpdateParameters(CubismModel* model, csmFloat32 userTimeSec
             continue;
         }
 
-        // Evaluate curve and apply value.
-        value = EvaluateCurve(_motionData, c, time, isCorrection, duration);
-
