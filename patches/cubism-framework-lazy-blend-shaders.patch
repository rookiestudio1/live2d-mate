+// [live2d_mate patch] 混合模式 shader 的延遲產生。
+//
+// GenerateShaders() 產生順序的逆推：ShaderNames_NormalAtop 之後每 6 個一組
+//（遮罩無／有／有反轉 × 是否乘算済アルファ），組的排列是先 (i=0, j=1..4)
+// 四組，之後才是 (i=1..15, j=0..4) 每個顏色模式各五組 —— 因為 Normal Over
+// 用的就是 ShaderNames_Normal 那支，不必另外產生。
+//
+// 一次只補一支（不是整組六支）：一個 drawable 只會用到其中一種遮罩組合，
+// 補整組等於白編五支。實測單支約 6 ms，第一次用到時掉一幀，之後就都有了。
+void CubismShader_OpenGLES2::EnsureBlendShaderSet(const csmInt32 shaderName)
+{
+#ifndef CSM_TARGET_ANDROID_ES2
+    // 逆推的前提：混合模式區塊剛好是 (16 × 5 − 1) 組 × 6 支。
+    // 上游若改了排列（例如新增顏色模式）這裡會先編不過，而不是默默錯位拿到別支 shader。
+    static_assert(
+        (ShaderNames_ShaderCount - ShaderNames_NormalAtop) == (ColorBlendMode_Count * AlphaBlendMode_Count - 1) * 6,
+        "[live2d_mate patch] blend shader layout changed; EnsureBlendShaderSet() must be revisited");
+
+    // 混合模式以外的都在 GenerateShaders() 產生完了
+    if (shaderName < ShaderNames_NormalAtop || shaderName >= ShaderNames_ShaderCount)
+    {
+        return;
+    }
+    if (_shaderSets[shaderName]->ShaderProgram)
+    {
+        return;
+    }
+
+    const csmInt32 sequence = shaderName - ShaderNames_NormalAtop;
+    const csmInt32 group = sequence / 6;
+    const csmInt32 variant = sequence % 6;
+
+    csmInt32 colorBlendMode;
+    csmInt32 alphaBlendMode;
+    if (group < AlphaBlendMode_Count - 1)
+    {
+        colorBlendMode = 0;
+        alphaBlendMode = group + 1;  // Normal は Over を飛ばす
+    }
+    else
+    {
+        const csmInt32 rest = group - (AlphaBlendMode_Count - 1);
+        colorBlendMode = rest / AlphaBlendMode_Count + 1;
+        alphaBlendMode = rest % AlphaBlendMode_Count;
+    }
+
+    // 這兩張表的順序必須跟 GenerateShaders() 裡那六行一字不差
+    static const csmChar* vertPaths[6] = {
+        "FrameworkShaders/VertShaderSrcBlend.vert",
+        "FrameworkShaders/VertShaderSrcMaskedBlend.vert",
+        "FrameworkShaders/VertShaderSrcMaskedBlend.vert",
+        "FrameworkShaders/VertShaderSrcBlend.vert",
+        "FrameworkShaders/VertShaderSrcMaskedBlend.vert",
+        "FrameworkShaders/VertShaderSrcMaskedBlend.vert",
+    };
+    static const csmChar* fragPaths[6] = {
+        "FrameworkShaders/FragShaderSrcBlend.frag",
+        "FrameworkShaders/FragShaderSrcMaskBlend.frag",
+        "FrameworkShaders/FragShaderSrcMaskInvertedBlend.frag",
+        "FrameworkShaders/FragShaderSrcPremultipliedAlphaBlend.frag",
+        "FrameworkShaders/FragShaderSrcMaskPremultipliedAlphaBlend.frag",
+        "FrameworkShaders/FragShaderSrcMaskInvertedPremultipliedAlphaBlend.frag",
+    };
+
+    _shaderSets[shaderName]->ShaderProgram =
+        LoadShaderProgramFromFile(vertPaths[variant], fragPaths[variant], colorBlendMode, alphaBlendMode);
+    // MaskType_None..MaskType_MaskedInvertedPremultipliedAlpha は 0..5 で variant と同順
+    SetShaderSet(*_shaderSets[shaderName], static_cast<MaskType>(variant), true);
+#else
+    static_cast<void>(shaderName);
+#endif
 }
 
