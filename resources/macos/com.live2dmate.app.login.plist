<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  開機自啟用的 launchd agent，由 SMAppService.agentServiceWithPlistName 註冊，
	  隨 app bundle 放在 Contents/Library/LaunchAgents/。

	  為什麼不用 SMAppService.mainAppService（比較短的那條路）：
	  當初是為了「把隱藏旗標寫進 ProgramArguments」，而登入自啟已經不帶那個旗標了
	  （理由見 src/core/autostart_command.h）。仍然維持 agent 的原因見
	  src/platform/autostart_mac.mm —— 換過去會讓已註冊使用者手上這份 agent
	  留在 launchd 裡繼續 RunAtLoad，登入時被叫起來兩次。

	  註：XML 註解裡不可以出現連續兩個減號（會直接是 malformed XML），
	  所以這裡一律寫「隱藏旗標」而不是旗標本身。原本那份就踩了這條。

	  BundleProgram 是「相對於 bundle 的路徑」，所以使用者把 .app 搬到哪都還能跑；
	  寫絕對路徑的話搬一次就壞了。
	-->
	<key>Label</key>
	<string>com.live2dmate.app.login</string>

	<key>BundleProgram</key>
	<string>Contents/MacOS/live2d_mate</string>

	<!--
	  只有 argv[0]，照慣例放程式名 —— 自啟就是一次普通的啟動，不帶任何旗標。
	  真正執行的是上面的 BundleProgram。
	-->
	<key>ProgramArguments</key>
	<array>
		<string>live2d_mate</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<!--
	  沒有這個鍵，macOS 13+ 的「系統設定 → 一般 → 登入項目」會把它顯示成
	  com.live2dmate.app.login 這種原始 label，使用者根本不知道那是什麼。
	  關聯到 bundle id 之後才會顯示成 Live2D Mate。
	-->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.live2dmate.app</string>
	</array>
</dict>
</plist>
